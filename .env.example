MYSQL_DATABASE=planit
MYSQL_USER=planit
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

DB_URL=jdbc:mysql://localhost:3306/planit?connectionTimeZone=Asia/Seoul
DB_USERNAME=planit
DB_PASSWORD=replace-with-a-local-password

KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
KAKAO_ADMIN_KEY=replace-with-kakao-admin-key
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/oauth/callback

FRONTEND_BASE_URL=http://localhost:5173
ALLOWED_FRONTEND_ORIGIN=http://localhost:5173
AUTH_COOKIE_SECURE=false
JWT_HS256_SECRET_BASE64=replace-with-base64-encoded-32-byte-secret
DEFAULT_PROFILE_IMAGE_URL=http://localhost:8080/images/default-profile.svg
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_API_KEY=replace-with-ai-internal-api-key

# Sentry는 운영 서버에만 DSN을 설정한다. 비워 두면 로컬에서는 전송하지 않는다.
# 로컬 연결 테스트가 필요할 때만 잠시 값을 넣고 SENTRY_ENVIRONMENT=local로 구분한다.
# SENTRY_DSN=replace-with-sentry-dsn
# SENTRY_ENVIRONMENT=local
